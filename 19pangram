class Solution {
public:
    bool checkIfPangram(string sentence) {
        vector<bool>ans(26,0);
        for(int i=0;i<sentence.length();i++){
            int index=sentence[i]-'a';
            ans[index]=1;
        }
        for(int i=0;i<26;i++){
            if(ans[i]==0){
                return 0;
            }
        }
        return 1;
    }
};
