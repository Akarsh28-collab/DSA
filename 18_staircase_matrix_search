class Solution {
public:
    bool searchMatrix(vector<vector<int>>& matrix, int x) {
        int r=matrix.size();
        int c=matrix[0].size();
        int i=0;
       int j=c-1;
        while(i<r && j>=0){
        if(matrix[i][j]==x){
            
            return true;
        }
        else if(matrix[i][j]<x){
            i++;
        }
        else{
            j--;
        }
    }
   
    return false;
    }
};
