class Solution {
public:
    bool searchMatrix(vector<vector<int>>& matrix, int target) {
        int r=matrix.size();
        int c=matrix[0].size();
        int row_index;
        int col_index;
        int st=0;
        int end=r*c-1;
        int mid;
        while(st<=end){
            mid=end+(st-end)/2;
            row_index=mid/c;
            col_index=mid%c;
            if(matrix[row_index][col_index]==target){
                return 1;
            }
            else if(matrix[row_index][col_index]<target){
                st=mid+1;
            }
            else{
                end=mid-1;
            }
        }
        return 0;
    }
};
